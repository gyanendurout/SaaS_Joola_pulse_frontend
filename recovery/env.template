# JOOLA Pulse — Frontend env template
# Copy this file to `frontend/.env.local` and fill in real values.
# DO NOT commit the populated file. NEVER use the service-role key in any
# `NEXT_PUBLIC_*` variable — those are bundled into the browser.

# ---------------------------------------------------------------------------
# Supabase — REQUIRED. The dashboard talks directly to Supabase via these
# from server components. See secrets-checklist.md for where to get values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL={{SUPABASE_PROJECT_URL}}
NEXT_PUBLIC_SUPABASE_ANON_KEY={{SUPABASE_ANON_KEY}}

# ---------------------------------------------------------------------------
# OPTIONAL — only used by `scripts/scrape_joola_ig.py` (Python script, not
# Next.js). The Next app never reads these. Safe to leave blank if you
# don't run the IG backfill from this folder.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY={{SUPABASE_SERVICE_ROLE_KEY}}
APIFY_API_TOKEN={{APIFY_API_TOKEN}}
OPENAI_API_KEY={{OPENAI_API_KEY}}

# ---------------------------------------------------------------------------
# Backend proxy — points the Next.js `/seo-api/*` rewrite at the FastAPI
# backend. Local default is http://localhost:8000. On Vercel, set this to
# the deployed backend project URL (no trailing slash).
# ---------------------------------------------------------------------------
SEO_API_URL=http://localhost:8000
